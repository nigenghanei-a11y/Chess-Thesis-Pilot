.env
.DS_Store
Thumbs.db

# big raw data: re-downloadable; its size and SHA-256 are stored in outputs/.../download_manifest.json
data/raw/
*.zst
*.part

# working files of the profiling pass (large, regenerated by the notebook)
outputs/**/checkpoint.pkl
outputs/**/profile_state.pkl
# game_ids.u64: 8 bytes per game = about 760 MB for 95 million games; GitHub rejects files > 100 MB
outputs/**/game_ids.u64

# engine binary: do not commit; its SHA-256 is stored in the run manifest
stockfish/
